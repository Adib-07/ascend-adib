# Supabase — required on the private host (server) and at build time (VITE_*).
# SUPABASE_URL and VITE_SUPABASE_URL MUST point at the same project.
#
# Project: akoskmxdfjuroeeniyjy  (the project that holds the Ascend data)
SUPABASE_URL=https://akoskmxdfjuroeeniyjy.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=https://akoskmxdfjuroeeniyjy.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
#
# NEVER prefix the service-role key with VITE_ — it would ship to the browser.

# ---------------------------------------------------------------------------
# Owner session (single-owner personal OS)
# ---------------------------------------------------------------------------
# Server-only. A long-lived Supabase refresh token for the existing owner
# account. Ascend exchanges it server-side for a short-lived access token; the
# browser never receives this value, and it is never written to localStorage.
#
# Must NOT be VITE_-prefixed.
OWNER_REFRESH_TOKEN=
#
# Optional. Where the current (rotated) refresh token is persisted on the
# private host. Supabase rotates refresh tokens; this file keeps the app
# working across rotations and process restarts. Written with mode 0600.
# Defaults to ~/.ascend/owner-refresh-token
OWNER_REFRESH_TOKEN_FILE=
#
# Optional but recommended. The owner's auth user UUID. If set, the owner
# session is refused unless it belongs to exactly this user — this stops a
# mistyped or swapped token from silently handing the app a different identity.
# Find it in the database: select id, email from auth.users;
OWNER_USER_ID=

# Lovable AI Gateway (required for AI features)
LOVABLE_API_KEY=

# Kaggle (required for dataset ingestion)
KAGGLE_USERNAME=
KAGGLE_KEY=
